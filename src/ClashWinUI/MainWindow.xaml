<Window
    x:Class="ClashDotNetFramework.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- RootGrid 保持透明，Mica 材质由代码中的 SystemBackdrop 提供 -->
    <Grid x:Name="RootGrid">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowSizeStates">
                <!-- 宽窗口：完整导航窗格（图标 + 文字 + 分组标题） -->
                <VisualState x:Name="WideWindowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="968" />
                    </VisualState.StateTriggers>
                </VisualState>
                <!-- 窄窗口：折叠为紧凑图标栏，顶部汉堡按钮可临时展开 -->
                <VisualState x:Name="NarrowWindowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="NavView.PaneDisplayMode" Value="LeftCompact" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <NavigationView x:Name="NavView"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsPaneOpen="True"
                        IsTitleBarAutoPaddingEnabled="True"
                        OpenPaneLength="224"
                        CompactPaneLength="48"
                        Background="Transparent"
                        SelectionChanged="NavView_SelectionChanged">

            <!-- ==================== 自定义标题栏（与导航窗格融为一体） ====================
                 注意：拖拽区域只能是这 48px 的窗格头（PaneTitleBar）。
                 不能像旧版那样把整个 NavView 设为标题栏 —— 那会把整个内容区变成非客户区，
                 鼠标滚轮会被系统当作 NC 消息吞掉（设置页等无法滚动）。 -->
            <NavigationView.PaneHeader>
                <Grid x:Name="PaneTitleBar"
                      Height="48" Margin="4,0,0,0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 应用 Logo（Assets 里现成的三套主题配色，随主题切换，见 ApplyAppLogo） -->
                    <Image x:Name="AppLogoImage"
                           Grid.Column="0"
                           Width="28"
                           Height="28"
                           VerticalAlignment="Center" />

                    <TextBlock x:Name="AppTitleText"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}"
                               Text="ClashWinUI"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </NavigationView.PaneHeader>

            <!-- ==================== 导航菜单（按用途分三段） ==================== -->
            <NavigationView.MenuItems>
                <NavigationViewItemHeader Content="{x:Bind Loc.NavGroupRuntime, Mode=OneWay}" />

                <NavigationViewItem Tag="Overview" Content="{x:Bind Loc.Overview, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Proxies" Content="{x:Bind Loc.Proxies, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemHeader Content="{x:Bind Loc.NavGroupTraffic, Mode=OneWay}" />

                <NavigationViewItem Tag="Connections" Content="{x:Bind Loc.Connections, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71B;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Rules" Content="{x:Bind Loc.Rules, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA37;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Logs" Content="{x:Bind Loc.Logs, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8BD;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemHeader Content="{x:Bind Loc.NavGroupManage, Mode=OneWay}" />

                <NavigationViewItem Tag="Profiles" Content="{x:Bind Loc.Profiles, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Support" Content="{x:Bind Loc.Support, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE897;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- ==================== 底部：实时流量 + 状态 + 设置入口 ==================== -->
            <NavigationView.PaneFooter>
                <StackPanel Padding="12,4,12,12" Spacing="8">

                    <!-- 实时上下行流量（等宽字体，避免数字跳动） -->
                    <Border x:Name="PaneTrafficBox"
                            Style="{StaticResource SubtleCardBorderStyle}"
                            Padding="10,8"
                            CornerRadius="{StaticResource ControlCornerRadius}">
                        <StackPanel Spacing="6">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE898;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          FontSize="12"
                                          Foreground="{ThemeResource BrandPrimaryBrush}"
                                          VerticalAlignment="Center" />
                                <TextBlock x:Name="UploadSpeed"
                                           Grid.Column="1"
                                           Text="0.00 B/s"
                                           Style="{StaticResource MonospaceTextBlockStyle}"
                                           HorizontalAlignment="Right" />
                            </Grid>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE896;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          FontSize="12"
                                          Foreground="{ThemeResource BrandPrimaryBrush}"
                                          VerticalAlignment="Center" />
                                <TextBlock x:Name="DownloadSpeed"
                                           Grid.Column="1"
                                           Text="0.00 B/s"
                                           Style="{StaticResource MonospaceTextBlockStyle}"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 连接状态 -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="2,0">
                        <Ellipse x:Name="StatusLight" Width="8" Height="8" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   Text="Disconnected"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- 运行时长 -->
                    <TextBlock x:Name="ConnectionTime"
                               Style="{StaticResource MonospaceTextBlockStyle}"
                               Padding="2,0"
                               Foreground="{ThemeResource TextSecondaryBrush}"
                               Text="00 : 00 : 00" />

                    <TextBlock x:Name="CoreVersionText"
                               Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                               FontSize="{StaticResource FontSizeMicro}"
                               Text="Core Version: Unknown"
                               TextWrapping="Wrap"
                               Padding="2,0" />

                    <Rectangle x:Name="PaneDivider"
                               Height="1"
                               Margin="0,4"
                               Fill="{ThemeResource SurfaceDividerBrush}" />

                    <!-- 底部“设置”入口 -->
                    <Grid Height="36" Margin="-8,0,-8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 选中态背景 -->
                        <Border x:Name="SettingsFooterHighlight"
                                Grid.ColumnSpan="2"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                Background="{ThemeResource BrandSubtleBrush}"
                                Visibility="Collapsed" />

                        <Button x:Name="FooterSettingsButton"
                                Grid.ColumnSpan="2"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="8,0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Tag="Settings"
                                Click="FooterNavItem_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE713;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          FontSize="16"
                                          VerticalAlignment="Center" />
                                <TextBlock x:Name="SettingsFooterText"
                                           Text="{x:Bind Loc.Settings, Mode=OneWay}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </NavigationView.PaneFooter>

            <Frame x:Name="PageFrame" />
        </NavigationView>
    </Grid>
</Window>
