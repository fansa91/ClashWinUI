<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        调色板 · 现代（浅色 + 青绿）
        ==============================
        键名与 Palette.Classic / Palette.Dark 完全一致。
        "现代"相比"经典"：强调色偏青绿、描边更淡、表面略带冷调，整体更轻。
    -->

    <!-- ==================== 表面 ==================== -->
    <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#F6F8F8" />
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceCardHoverBrush" Color="#F6FBFA" />
    <SolidColorBrush x:Key="SurfaceCardStrokeBrush" Color="#E2E9E7" />
    <SolidColorBrush x:Key="SurfaceCardStrokeHoverBrush" Color="#BED4CF" />
    <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#F2F6F5" />
    <SolidColorBrush x:Key="SurfaceSubtleStrokeBrush" Color="#E3EBE9" />
    <SolidColorBrush x:Key="SurfaceDividerBrush" Color="#E7EDEB" />

    <!-- ==================== 品牌 / 强调 ==================== -->
    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#0E7C6B" />
    <SolidColorBrush x:Key="BrandPrimaryHoverBrush" Color="#0A6255" />
    <SolidColorBrush x:Key="BrandSubtleBrush" Color="#E1F3EF" />
    <SolidColorBrush x:Key="TextOnBrandBrush" Color="#FFFFFF" />

    <!-- ==================== 文字层级 ==================== -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#16201E" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5A6A66" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8C9A97" />

    <!-- ==================== 语义色 ==================== -->
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#0E7C4A" />
    <SolidColorBrush x:Key="StatusSuccessSubtleBrush" Color="#DDF4E7" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#8A5A00" />
    <SolidColorBrush x:Key="StatusWarningSubtleBrush" Color="#FDF2D9" />
    <SolidColorBrush x:Key="StatusDangerBrush" Color="#C0392B" />
    <SolidColorBrush x:Key="StatusDangerSubtleBrush" Color="#FCE9E7" />
    <SolidColorBrush x:Key="StatusNeutralBrush" Color="#5E6B68" />
    <SolidColorBrush x:Key="StatusNeutralSubtleBrush" Color="#EFF4F2" />
    <!-- 信息色：用于"负载均衡"等既非成功也非警告的分类 -->
    <SolidColorBrush x:Key="StatusInfoBrush" Color="#3A6EA8" />
    <SolidColorBrush x:Key="StatusInfoSubtleBrush" Color="#E8F0FA" />

    <!-- ==================== 图表 ==================== -->
    <SolidColorBrush x:Key="ChartUploadBrush" Color="#0E7CB0" />
    <SolidColorBrush x:Key="ChartDownloadBrush" Color="#0E7C4A" />
    <SolidColorBrush x:Key="ChartGridBrush" Color="#E8EFED" />

    <!-- ==================== WinUI 内置强调键覆写 ==================== -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0E7C6B" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#0A6255" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#0E7C6B" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E3F5F1" />

</ResourceDictionary>
