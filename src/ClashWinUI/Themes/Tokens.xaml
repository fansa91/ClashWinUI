<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        设计令牌 · 度量层
        ==================
        这里只放"与主题无关"的尺寸类令牌：间距、圆角、字号、图标尺寸、行高。
        颜色一律放在 Palette.*.xaml（每套主题一份），控件只允许引用令牌名，不写字面色值。

        栅格约定：4px 基准，常用 8 / 12 / 16 / 24。
    -->

    <!-- ==================== 页面 ==================== -->
    <Thickness x:Key="PageMargin">24,20,24,24</Thickness>
    <Thickness x:Key="PageMarginCompact">16,14,16,16</Thickness>
    <Thickness x:Key="PageHeaderMargin">0,0,0,16</Thickness>

    <!-- ==================== 卡片与容器内边距 ==================== -->
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="CardPaddingCompact">12</Thickness>
    <Thickness x:Key="CardPaddingWide">20</Thickness>
    <Thickness x:Key="ToolbarPadding">12,8</Thickness>

    <!-- ==================== 圆角 ==================== -->
    <CornerRadius x:Key="CardCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="CardCornerRadiusLarge">14</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <!-- 药丸形（计数徽章、状态标签），取值大于任何实际高度的一半即可 -->
    <CornerRadius x:Key="PillCornerRadius">999</CornerRadius>

    <!-- ==================== 间距 ==================== -->
    <x:Double x:Key="ContentGap">8</x:Double>
    <x:Double x:Key="SectionGap">16</x:Double>
    <x:Double x:Key="CardGap">12</x:Double>
    <x:Double x:Key="TightGap">4</x:Double>

    <!-- ==================== 图标 ==================== -->
    <x:Double x:Key="IconSizeSmall">16</x:Double>
    <x:Double x:Key="IconSizeMedium">20</x:Double>
    <x:Double x:Key="IconSizeLarge">28</x:Double>
    <x:Double x:Key="EmptyStateIconSize">36</x:Double>

    <!-- ==================== 字号 ==================== -->
    <x:Double x:Key="FontSizePageTitle">28</x:Double>
    <x:Double x:Key="FontSizeSectionTitle">16</x:Double>
    <x:Double x:Key="FontSizeCardTitle">14</x:Double>
    <x:Double x:Key="FontSizeBody">13</x:Double>
    <x:Double x:Key="FontSizeCaption">12</x:Double>
    <x:Double x:Key="FontSizeMicro">11</x:Double>
    <x:Double x:Key="FontSizeMetric">26</x:Double>
    <x:Double x:Key="FontSizeMetricLarge">34</x:Double>

    <!-- ==================== 字体 ==================== -->
    <!-- 数值统一用等宽字体，避免数字变化时行内宽度跳动 -->
    <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas</FontFamily>

    <!-- ==================== 行高 ==================== -->
    <x:Double x:Key="ListRowHeight">48</x:Double>
    <x:Double x:Key="CompactRowHeight">40</x:Double>

</ResourceDictionary>
