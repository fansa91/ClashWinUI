<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        调色板 · 深色
        ==============
        键名与 Palette.Classic / Palette.Modern 完全一致。
        表面使用半透明白叠加在 Mica 之上，保留材质透视感；
        语义色改为高亮版本，保证深底上的可读性。
    -->

    <!-- ==================== 表面 ==================== -->
    <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#1C1C1C" />
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="SurfaceCardHoverBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="SurfaceCardStrokeBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="SurfaceCardStrokeHoverBrush" Color="#3DFFFFFF" />
    <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="SurfaceSubtleStrokeBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="SurfaceDividerBrush" Color="#26FFFFFF" />

    <!-- ==================== 品牌 / 强调 ==================== -->
    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#2E8F82" />
    <SolidColorBrush x:Key="BrandPrimaryHoverBrush" Color="#3AA99A" />
    <SolidColorBrush x:Key="BrandSubtleBrush" Color="#1B3A36" />
    <SolidColorBrush x:Key="TextOnBrandBrush" Color="#FFFFFF" />

    <!-- ==================== 文字层级 ==================== -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F5F5" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B9B9B9" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8C8C8C" />

    <!-- ==================== 语义色 ==================== -->
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#6CCB5F" />
    <SolidColorBrush x:Key="StatusSuccessSubtleBrush" Color="#1E3A1B" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#E8C547" />
    <SolidColorBrush x:Key="StatusWarningSubtleBrush" Color="#3A2E00" />
    <SolidColorBrush x:Key="StatusDangerBrush" Color="#FF8A80" />
    <SolidColorBrush x:Key="StatusDangerSubtleBrush" Color="#42191B" />
    <SolidColorBrush x:Key="StatusNeutralBrush" Color="#C8C8C8" />
    <SolidColorBrush x:Key="StatusNeutralSubtleBrush" Color="#2E2E2E" />
    <!-- 信息色：用于"负载均衡"等既非成功也非警告的分类 -->
    <SolidColorBrush x:Key="StatusInfoBrush" Color="#A9A2F0" />
    <SolidColorBrush x:Key="StatusInfoSubtleBrush" Color="#262150" />

    <!-- ==================== 图表 ==================== -->
    <SolidColorBrush x:Key="ChartUploadBrush" Color="#4FC3F7" />
    <SolidColorBrush x:Key="ChartDownloadBrush" Color="#6FD08C" />
    <SolidColorBrush x:Key="ChartGridBrush" Color="#3A3A3A" />

    <!-- ==================== WinUI 内置强调键覆写 ==================== -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#2E8F82" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#5FBFAE" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#7FD2C4" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#D9F0EB" />

    <!--
        控件模板里的强调色走 ThemeResource 查找，会被 XamlControlsResources 自带的
        ThemeDictionaries 抢先命中；只有把同样的键放进主题字典里才能真正覆盖，
        否则开关、主按钮会停留在系统强调色（蓝），与页面强调色割裂。
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="SystemAccentColor">#0E7C6B</Color>
            <Color x:Key="SystemAccentColorLight1">#0E8C79</Color>
            <Color x:Key="SystemAccentColorLight2">#12A08A</Color>
            <Color x:Key="SystemAccentColorLight3">#17B49C</Color>
            <Color x:Key="SystemAccentColorDark1">#0A6255</Color>
            <Color x:Key="SystemAccentColorDark2">#084D43</Color>
            <Color x:Key="SystemAccentColorDark3">#053A32</Color>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0E7C6B" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#0E7C6B" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#E1F3EF" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#0A6255" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#0E7C6B" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#0A6255" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E1F3EF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="SystemAccentColor">#2E8F82</Color>
            <Color x:Key="SystemAccentColorLight1">#3AA294</Color>
            <Color x:Key="SystemAccentColorLight2">#48B5A6</Color>
            <Color x:Key="SystemAccentColorLight3">#5BC7B8</Color>
            <Color x:Key="SystemAccentColorDark1">#237366</Color>
            <Color x:Key="SystemAccentColorDark2">#1B5A50</Color>
            <Color x:Key="SystemAccentColorDark3">#12423B</Color>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#2E8F82" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#2E8F82" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#1B3A36" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#1B3A36" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#2E8F82" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#1B3A36" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#1B3A36" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
