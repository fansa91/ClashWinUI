<Page
    x:Class="ClashDotNetFramework.Pages.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="LogsPage_Loaded"
    Unloaded="LogsPage_Unloaded">

    <Grid Padding="{StaticResource PageMargin}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页面标题 + 日志条数 -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind Loc.Logs, Mode=OneWay}"
                       Style="{StaticResource PageTitleTextBlockStyle}" />
            <Border Grid.Column="1" Style="{StaticResource CountBadgeStyle}">
                <TextBlock x:Name="LogCountText"
                           Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
            </Border>
        </Grid>

        <!-- 顶部固定工具栏 -->
        <Border Grid.Row="1" Style="{StaticResource ToolbarBorderStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <AutoSuggestBox x:Name="LogSearchBox"
                                Width="220"
                                VerticalAlignment="Center"
                                PlaceholderText="{x:Bind Loc.SearchPlaceholder, Mode=OneWay}"
                                QueryIcon="Find"
                                TextChanged="LogSearchBox_TextChanged" />

                <ComboBox x:Name="LogLevelFilter"
                          Grid.Column="1"
                          Width="120"
                          VerticalAlignment="Center"
                          SelectedIndex="0"
                          SelectionChanged="LogLevelFilter_SelectionChanged">
                    <ComboBoxItem Content="{x:Bind Loc.AllLevels, Mode=OneWay}" Tag="All" />
                    <ComboBoxItem Content="{x:Bind Loc.Info, Mode=OneWay}" Tag="Info" />
                    <ComboBoxItem Content="{x:Bind Loc.Warning, Mode=OneWay}" Tag="Warning" />
                    <ComboBoxItem Content="{x:Bind Loc.Error, Mode=OneWay}" Tag="Error" />
                    <ComboBoxItem Content="{x:Bind Loc.Debug, Mode=OneWay}" Tag="Debug" />
                </ComboBox>

                <CheckBox x:Name="AutoScrollCheck"
                          Grid.Column="3"
                          Content="{x:Bind Loc.AutoScroll, Mode=OneWay}"
                          IsChecked="True"
                          VerticalAlignment="Center" />

                <StackPanel Grid.Column="4"
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="StatusButton"
                            Click="StatusButton_Click"
                            MinWidth="80" />
                    <Button x:Name="ClearButton"
                            Content="{x:Bind Loc.Clear, Mode=OneWay}"
                            Click="ClearButton_Click"
                            MinWidth="80" />
                    <Button x:Name="ExportButton"
                            Content="{x:Bind Loc.Export, Mode=OneWay}"
                            Click="ExportButton_Click"
                            MinWidth="80" />
                    <Button x:Name="ClearFilterButton"
                            Content="{x:Bind Loc.ClearFilter, Mode=OneWay}"
                            Click="ClearFilterButton_Click"
                            Visibility="Collapsed" />
                </StackPanel>

                <TextBlock x:Name="CurrentMode"
                           Grid.Column="5"
                           Margin="4,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
            </Grid>
        </Border>

        <!-- 列头：右侧留滚动条宽度，与数据行对齐 -->
        <Grid Grid.Row="2"
              Margin="0,0,0,8"
              Padding="12,8,28,8"
              ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind Loc.Time, Mode=OneWay}"
                       Style="{StaticResource ColumnHeaderTextBlockStyle}" />
            <TextBlock Grid.Column="1"
                       Text="{x:Bind Loc.Level, Mode=OneWay}"
                       Style="{StaticResource ColumnHeaderTextBlockStyle}" />
            <TextBlock Grid.Column="2"
                       Text="{x:Bind Loc.Payload, Mode=OneWay}"
                       Style="{StaticResource ColumnHeaderTextBlockStyle}" />
        </Grid>

        <!-- 日志列表（虚拟化，等宽字体） -->
        <ListView x:Name="LogItemListView"
                  Grid.Row="3"
                  SelectionMode="None"
                  ItemContainerStyle="{StaticResource VListItemContainerStyle}"
                  ScrollViewer.HorizontalScrollMode="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="12,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Time, Mode=OneWay}"
                                   Opacity="0.7"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource MonospaceTextBlockStyle}" />
                        <Border Grid.Column="1"
                                Style="{StaticResource SemanticTagBorderStyle}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{Binding Level, Mode=OneWay, Converter={StaticResource LevelToBackground}}">
                            <TextBlock Text="{Binding Level, Mode=OneWay}"
                                       Foreground="{Binding Level, Mode=OneWay, Converter={StaticResource LevelToColor}}"
                                       FontWeight="SemiBold"
                                       Style="{StaticResource MonospaceTextBlockStyle}" />
                        </Border>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding PayLoad, Mode=OneWay}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{Binding PayLoad, Mode=OneWay}"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource MonospaceBodyTextBlockStyle}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 空状态：无日志 / 筛选无结果 -->
        <StackPanel x:Name="EmptyStatePanel"
                    Grid.Row="3"
                    Style="{StaticResource EmptyStatePanelStyle}"
                    Visibility="Collapsed">
            <FontIcon Style="{StaticResource EmptyStateIconStyle}" />
            <TextBlock x:Name="EmptyText"
                       Text="{x:Bind Loc.NoLogs, Mode=OneWay}"
                       Style="{StaticResource EmptyStateTextStyle}" />
            <Button x:Name="ClearEmptyFilterButton"
                    Content="{x:Bind Loc.ClearFilter, Mode=OneWay}"
                    Click="ClearFilterButton_Click"
                    Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Page>
