<Page
    x:Class="ClashDotNetFramework.Pages.RulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">

    <Grid Padding="{StaticResource PageMargin}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页面标题 + 规则总数 -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind Loc.Rules, Mode=OneWay}"
                       Style="{StaticResource PageTitleTextBlockStyle}" />
            <Border Grid.Column="1" Style="{StaticResource CountBadgeStyle}">
                <TextBlock x:Name="RuleCountText"
                           Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
            </Border>
        </Grid>

        <!-- 工具栏：搜索 + 类型 / 策略筛选 -->
        <Border Grid.Row="1" Style="{StaticResource ToolbarBorderStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <AutoSuggestBox x:Name="RuleSearchBox"
                                Width="260"
                                VerticalAlignment="Center"
                                PlaceholderText="{x:Bind Loc.SearchPlaceholder, Mode=OneWay}"
                                QueryIcon="Find"
                                TextChanged="RuleSearchBox_TextChanged" />

                <ComboBox x:Name="TypeFilterBox"
                          Grid.Column="1"
                          Width="140"
                          VerticalAlignment="Center"
                          SelectedIndex="0"
                          SelectionChanged="FilterBox_SelectionChanged">
                    <ComboBoxItem Content="{x:Bind Loc.All, Mode=OneWay}" Tag="All" />
                    <ComboBoxItem Content="{x:Bind Loc.TypeDomain, Mode=OneWay}" Tag="Domain" />
                    <ComboBoxItem Content="{x:Bind Loc.TypeIp, Mode=OneWay}" Tag="Ip" />
                    <ComboBoxItem Content="{x:Bind Loc.TypeGeo, Mode=OneWay}" Tag="Geo" />
                    <ComboBoxItem Content="{x:Bind Loc.TypeOther, Mode=OneWay}" Tag="Other" />
                </ComboBox>

                <ComboBox x:Name="PolicyFilterBox"
                          Grid.Column="2"
                          Width="140"
                          VerticalAlignment="Center"
                          SelectedIndex="0"
                          SelectionChanged="FilterBox_SelectionChanged">
                    <ComboBoxItem Content="{x:Bind Loc.All, Mode=OneWay}" Tag="All" />
                    <ComboBoxItem Content="{x:Bind Loc.PolicyDirect, Mode=OneWay}" Tag="Direct" />
                    <ComboBoxItem Content="{x:Bind Loc.PolicyReject, Mode=OneWay}" Tag="Reject" />
                    <ComboBoxItem Content="{x:Bind Loc.PolicyProxy, Mode=OneWay}" Tag="Proxy" />
                </ComboBox>

                <Button x:Name="ClearFilterButton"
                        Grid.Column="4"
                        Content="{x:Bind Loc.ClearFilter, Mode=OneWay}"
                        Click="ClearFilterButton_Click"
                        Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- 列头：右侧留滚动条宽度，与数据行对齐 -->
        <Grid Grid.Row="2"
              Margin="0,0,0,8"
              Padding="12,8,28,8"
              ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind Loc.RuleType, Mode=OneWay}"
                       Style="{StaticResource ColumnHeaderTextBlockStyle}" />
            <TextBlock Grid.Column="1"
                       Text="{x:Bind Loc.RulePayload, Mode=OneWay}"
                       Style="{StaticResource ColumnHeaderTextBlockStyle}" />
            <TextBlock Grid.Column="2"
                       Text="{x:Bind Loc.RuleProxy, Mode=OneWay}"
                       Style="{StaticResource ColumnHeaderTextBlockStyle}" />
        </Grid>

        <!-- 规则列表（虚拟化） -->
        <ListView x:Name="RuleItemListView"
                  Grid.Row="3"
                  SelectionMode="None"
                  ItemContainerStyle="{StaticResource VListItemContainerStyle}"
                  ScrollViewer.HorizontalScrollMode="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="12,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource TagBorderStyle}" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Type, Mode=OneWay}"
                                       Style="{StaticResource TagTextBlockStyle}"
                                       Foreground="{Binding Type, Mode=OneWay, Converter={StaticResource SemanticTag}, ConverterParameter=network}" />
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding PayLoad, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{Binding PayLoad, Mode=OneWay}"
                                   Style="{StaticResource MonospaceTextBlockStyle}" />
                        <Border Grid.Column="2"
                                Style="{StaticResource TagBorderStyle}"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Proxy, Mode=OneWay}"
                                       Style="{StaticResource TagTextBlockStyle}"
                                       Foreground="{Binding Proxy, Mode=OneWay, Converter={StaticResource SemanticTag}, ConverterParameter=proxy}" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 空状态：无规则 / 筛选无结果两种文案 -->
        <StackPanel x:Name="EmptyStatePanel"
                    Grid.Row="3"
                    Style="{StaticResource EmptyStatePanelStyle}"
                    Visibility="Collapsed">
            <FontIcon Style="{StaticResource EmptyStateIconStyle}" />
            <TextBlock x:Name="EmptyText"
                       Text="{x:Bind Loc.NoRules, Mode=OneWay}"
                       Style="{StaticResource EmptyStateTextStyle}" />
            <Button x:Name="ClearEmptyFilterButton"
                    Content="{x:Bind Loc.ClearFilter, Mode=OneWay}"
                    Click="ClearFilterButton_Click"
                    Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Page>
