<Page
    x:Class="ClashDotNetFramework.Pages.RulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding [Rules]}" FontSize="28" FontWeight="SemiBold" />

        <Grid Grid.Row="1" Margin="0,16,0,8" Padding="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding [RuleType]}" FontWeight="SemiBold" Opacity="0.7" />
            <TextBlock Grid.Column="1" Text="{Binding [RulePayload]}" FontWeight="SemiBold" Opacity="0.7" />
            <TextBlock Grid.Column="2" Text="{Binding [RuleProxy]}" FontWeight="SemiBold" Opacity="0.7" />
        </Grid>

        <ListView x:Name="RuleItemListView" Grid.Row="2" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Type}" />
                        <TextBlock Grid.Column="1" Text="{Binding PayLoad}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding Proxy}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>