<Page
    x:Class="ClashDotNetFramework.Pages.ProxiesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">

    <Grid Padding="{StaticResource PageMargin}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 标题 + 策略组计数 ==================== -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="{x:Bind Loc.Proxies, Mode=OneWay}"
                           Style="{StaticResource PageTitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind Loc.SelectGroupHint, Mode=OneWay}"
                           TextWrapping="Wrap"
                           Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextSecondaryBrush}" />
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource CountBadgeStyle}">
                <TextBlock x:Name="GroupCountText"
                           Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                           Text="" />
            </Border>
        </Grid>

        <!-- ==================== 模式分段 + 搜索 ==================== -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{ThemeResource SurfaceSubtleBrush}"
                    BorderBrush="{ThemeResource SurfaceDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="2"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="RuleModeButton" Tag="Rule"
                            Content="{x:Bind Loc.Rule, Mode=OneWay}"
                            Click="ModeButton_Click"
                            MinWidth="72" Padding="12,5,12,5"
                            BorderThickness="0" Background="Transparent" />
                    <Button x:Name="GlobalModeButton" Tag="Global"
                            Content="{x:Bind Loc.Global, Mode=OneWay}"
                            Click="ModeButton_Click"
                            MinWidth="72" Padding="12,5,12,5"
                            BorderThickness="0" Background="Transparent" />
                    <Button x:Name="DirectModeButton" Tag="Direct"
                            Content="{x:Bind Loc.Direct, Mode=OneWay}"
                            Click="ModeButton_Click"
                            MinWidth="72" Padding="12,5,12,5"
                            BorderThickness="0" Background="Transparent" />
                </StackPanel>
            </Border>

            <AutoSuggestBox x:Name="NodeSearchBox"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Width="260"
                            VerticalAlignment="Center"
                            PlaceholderText="{x:Bind Loc.SearchNodes, Mode=OneWay}"
                            QueryIcon="Find"
                            TextChanged="NodeSearchBox_TextChanged" />
        </Grid>

        <!-- ==================== 双栏：策略组 | 组成员 ==================== -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="260" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- 左栏：策略组列表 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Background="{ThemeResource SurfaceSubtleBrush}"
                            Padding="{StaticResource CardPadding}"
                            CornerRadius="{StaticResource ControlCornerRadius}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Loc.GroupCount, Mode=OneWay}"
                                       Style="{StaticResource SectionHeaderTextBlockStyle}" />
                            <TextBlock x:Name="GroupBadgeText"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                                       Text="" />
                        </Grid>
                    </Border>

                    <ListView x:Name="GroupListView"
                              Grid.Row="1"
                              Padding="6"
                              SelectionMode="Single"
                              SelectionChanged="GroupListView_SelectionChanged"
                              ItemContainerStyle="{StaticResource VListItemContainerStyle}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="10" Padding="0,6,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 类型色条 -->
                                    <Rectangle Width="3" RadiusX="2" RadiusY="2"
                                               VerticalAlignment="Stretch"
                                               Fill="{Binding TypeBrush, Mode=OneWay}" />

                                    <StackPanel Grid.Column="1" Spacing="5">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name, Mode=OneWay}"
                                                       FontSize="14"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ToolTip="{Binding Name, Mode=OneWay}" />
                                            <Border Grid.Column="1"
                                                    Style="{StaticResource SemanticTagBorderStyle}"
                                                    Background="{Binding TypeBackground, Mode=OneWay}">
                                                <TextBlock Text="{Binding TypeLabel, Mode=OneWay}"
                                                           Style="{StaticResource SemanticTagTextStyle}"
                                                           Foreground="{Binding TypeBrush, Mode=OneWay}"
                                                           ToolTipService.ToolTip="{Binding TypeDescription, Mode=OneWay}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Summary, Mode=OneWay}"
                                                   Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- 右栏：当前策略组的成员 -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                <Grid RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 当前组标题 -->
                    <Border Background="{ThemeResource SurfaceSubtleBrush}"
                            Padding="{StaticResource CardPadding}"
                            CornerRadius="{StaticResource ControlCornerRadius}">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="SelectedGroupTypeBadge"
                                    Style="{StaticResource SemanticTagBorderStyle}"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="SelectedGroupTypeText"
                                           FontSize="11" />
                            </Border>
                            <TextBlock x:Name="SelectedGroupNameText"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource SectionHeaderTextBlockStyle}"
                                       Text="" />
                            <TextBlock x:Name="SelectedGroupSummaryText"
                                       Grid.Column="2"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                                       Text="" />
                        </Grid>
                    </Border>

                    <!-- 组内筛选行：用 Button 手管选中态，避开 RadioButton 在 XAML 初始化期的崩溃 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"
                                Margin="12,10,12,6" VerticalAlignment="Center">
                        <Button x:Name="FilterAllButton"
                                Content="{x:Bind Loc.FilterAll, Mode=OneWay}"
                                Tag="All" Click="FilterButton_Click"
                                MinWidth="0" Padding="12,4,12,4" />
                        <Button x:Name="FilterAvailableButton"
                                Content="{x:Bind Loc.FilterAvailable, Mode=OneWay}"
                                Tag="Available" Click="FilterButton_Click"
                                MinWidth="0" Padding="12,4,12,4" />
                        <Button x:Name="FilterUntestedButton"
                                Content="{x:Bind Loc.Untested, Mode=OneWay}"
                                Tag="Untested" Click="FilterButton_Click"
                                MinWidth="0" Padding="12,4,12,4" />
                        <Button x:Name="SortLatencyButton"
                                Content="{x:Bind Loc.SortByLatency, Mode=OneWay}"
                                Click="SortLatencyButton_Click"
                                MinWidth="0" Padding="12,4,12,4" />
                    </StackPanel>

                    <!-- 成员卡片列表 -->
                    <GridView x:Name="ProxyGridView"
                              Grid.Row="2"
                              Padding="12,0,12,12"
                              SelectionMode="Single"
                              SelectionChanged="ProxyGridView_SelectionChanged"
                              ItemContainerStyle="{StaticResource VCardItemContainerStyle}"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Grid MinWidth="360">
                                    <Border Background="{ThemeResource SurfaceCardBrush}"
                                            BorderBrush="{ThemeResource SurfaceCardStrokeBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12" />
                                    <Border Background="{ThemeResource BrandSubtleBrush}"
                                            BorderBrush="{ThemeResource BrandPrimaryBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12"
                                            Visibility="{Binding IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Width="3">
                                            <Border CornerRadius="2"
                                                    Background="{ThemeResource BrandPrimaryBrush}"
                                                    Visibility="{Binding IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name, Mode=OneWay}"
                                                           VerticalAlignment="Center"
                                                           FontSize="14"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="1" Style="{StaticResource TagBorderStyle}">
                                                    <TextBlock Text="{Binding Type, Mode=OneWay}"
                                                               Style="{StaticResource TagTextBlockStyle}" />
                                                </Border>
                                            </Grid>
                                            <Border Style="{StaticResource SemanticTagBorderStyle}"
                                                    HorizontalAlignment="Left"
                                                    Background="{Binding Latency, Mode=OneWay, Converter={StaticResource LatencyToBackground}}">
                                                <TextBlock Text="{Binding Latency, Mode=OneWay, Converter={StaticResource LatencyToText}}"
                                                           Foreground="{Binding Latency, Mode=OneWay, Converter={StaticResource LatencyToBrush}}"
                                                           FontFamily="Cascadia Mono, Consolas"
                                                           FontSize="11" />
                                            </Border>
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Width="36" Height="32" Padding="0"
                                                ToolTipService.ToolTip="{Binding Test, Mode=OneWay}"
                                                Tag="{Binding Name, Mode=OneWay}"
                                                Click="TestButton_Click">
                                            <FontIcon Glyph="&#xE72C;"
                                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                      FontSize="14" />
                                        </Button>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 空状态 ==================== -->
        <StackPanel x:Name="EmptyStatePanel"
                    Grid.Row="2"
                    Style="{StaticResource EmptyStatePanelStyle}"
                    Visibility="Collapsed">
            <FontIcon Style="{StaticResource EmptyStateIconStyle}" />
            <TextBlock Text="{x:Bind Loc.NoProxies, Mode=OneWay}"
                       Style="{StaticResource EmptyStateTextStyle}" />
            <Button Content="{x:Bind Loc.GoToProfiles, Mode=OneWay}"
                    Click="GoToProfiles_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    MinWidth="120" />
        </StackPanel>
    </Grid>
</Page>
