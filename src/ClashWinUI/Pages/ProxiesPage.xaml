<Page
    x:Class="ClashDotNetFramework.Pages.ProxiesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">

    <Grid x:Name="RootGrid"
          Padding="{StaticResource PageMargin}"
          RowSpacing="12"
          SizeChanged="RootGrid_SizeChanged">

        <VisualStateManager.VisualStateGroups>
            <!-- 两个状态只描述差异；离开状态时 Setter 会自动回到 XAML 里的基准值 -->
            <VisualStateGroup x:Name="ProxyLayoutStates">
                <VisualState x:Name="WideProxies" />
                <VisualState x:Name="NarrowProxies">
                    <VisualState.Setters>
                        <Setter Target="GroupColumn.Width" Value="*" />
                        <Setter Target="GroupCard.(Grid.RowSpan)" Value="1" />
                        <Setter Target="GroupCard.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="GroupCard.Height" Value="248" />
                        <Setter Target="GroupCard.Margin" Value="0" />
                        <Setter Target="NodeCard.(Grid.Row)" Value="1" />
                        <Setter Target="NodeCard.(Grid.RowSpan)" Value="1" />
                        <Setter Target="NodeCard.(Grid.Column)" Value="0" />
                        <Setter Target="NodeCard.(Grid.ColumnSpan)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 标题 + 策略组计数 ==================== -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="{x:Bind Loc.Proxies, Mode=OneWay}"
                           Style="{StaticResource PageTitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind Loc.SelectGroupHint, Mode=OneWay}"
                           TextWrapping="Wrap"
                           Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource CountBadgeStyle}">
                <TextBlock x:Name="GroupCountText"
                           Style="{StaticResource CountBadgeTextStyle}"
                           Text="" />
            </Border>
        </Grid>

        <!-- ==================== 工具栏：模式分段 + 搜索 ==================== -->
        <Border Grid.Row="1" Style="{StaticResource ToolbarBorderStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 模式分段：用 Button 手管选中态 -->
                <Border Background="{ThemeResource SurfaceCardBrush}"
                        BorderBrush="{ThemeResource SurfaceCardStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Padding="2"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="RuleModeButton" Tag="Rule"
                                Content="{x:Bind Loc.Rule, Mode=OneWay}"
                                Click="ModeButton_Click"
                                MinWidth="72" Padding="12,5,12,5"
                                BorderThickness="0" Background="Transparent" />
                        <Button x:Name="GlobalModeButton" Tag="Global"
                                Content="{x:Bind Loc.Global, Mode=OneWay}"
                                Click="ModeButton_Click"
                                MinWidth="72" Padding="12,5,12,5"
                                BorderThickness="0" Background="Transparent" />
                        <Button x:Name="DirectModeButton" Tag="Direct"
                                Content="{x:Bind Loc.Direct, Mode=OneWay}"
                                Click="ModeButton_Click"
                                MinWidth="72" Padding="12,5,12,5"
                                BorderThickness="0" Background="Transparent" />
                    </StackPanel>
                </Border>

                <AutoSuggestBox x:Name="NodeSearchBox"
                                Grid.Column="2"
                                Width="220"
                                VerticalAlignment="Center"
                                PlaceholderText="{x:Bind Loc.SearchNodes, Mode=OneWay}"
                                QueryIcon="Find"
                                TextChanged="NodeSearchBox_TextChanged" />
            </Grid>
        </Border>

        <!-- ==================== 双栏：策略组 | 组成员 ==================== -->
        <Grid Grid.Row="2" ColumnSpacing="12" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="GroupColumn" Width="330" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左栏：策略组卡片 -->
            <Border x:Name="GroupCard"
                    Grid.Row="0" Grid.Column="0"
                    Grid.RowSpan="2"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Padding="16,12,16,10" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Loc.GroupCount, Mode=OneWay}"
                                   Style="{StaticResource SectionHeaderTextBlockStyle}"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="1" Style="{StaticResource CountBadgeStyle}">
                            <TextBlock x:Name="GroupBadgeText"
                                       Style="{StaticResource CountBadgeTextStyle}" />
                        </Border>
                    </Grid>

                    <ListView x:Name="GroupListView"
                              Grid.Row="1"
                              Padding="10,0,10,10"
                              SelectionMode="Single"
                              SelectionChanged="GroupListView_SelectionChanged"
                              ItemContainerStyle="{StaticResource CardListItemContainerStyle}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardOutlineStyle}" Padding="12,10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 类型色条 -->
                                        <Rectangle Width="3" RadiusX="2" RadiusY="2"
                                                   VerticalAlignment="Stretch"
                                                   Fill="{Binding TypeBrush, Mode=OneWay}" />

                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name, Mode=OneWay}"
                                                           Style="{StaticResource CardTitleTextBlockStyle}"
                                                           ToolTipService.ToolTip="{Binding Name, Mode=OneWay}" />
                                                <Border Grid.Column="1"
                                                        Style="{StaticResource SemanticTagBorderStyle}"
                                                        Background="{Binding TypeBackground, Mode=OneWay}">
                                                    <TextBlock Text="{Binding TypeLabel, Mode=OneWay}"
                                                               Style="{StaticResource SemanticTagTextStyle}"
                                                               Foreground="{Binding TypeBrush, Mode=OneWay}"
                                                               ToolTipService.ToolTip="{Binding TypeDescription, Mode=OneWay}" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Summary, Mode=OneWay}"
                                                       Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- 右栏：当前策略组的成员卡片 -->
            <Border x:Name="NodeCard"
                    Grid.Row="0" Grid.Column="1"
                    Grid.RowSpan="2"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 当前组标题 -->
                    <Grid Padding="16,12,16,10" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="SelectedGroupTypeBadge"
                                Style="{StaticResource SemanticTagBorderStyle}"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="SelectedGroupTypeText"
                                       Style="{StaticResource SemanticTagTextStyle}" />
                        </Border>
                        <TextBlock x:Name="SelectedGroupNameText"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource SectionHeaderTextBlockStyle}"
                                   Text="" />
                        <TextBlock x:Name="SelectedGroupSummaryText"
                                   Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                                   Text="" />
                    </Grid>

                    <!-- 组内筛选行 + 延迟分级图例 -->
                    <Grid Grid.Row="1" Margin="14,0,14,10" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button x:Name="FilterAllButton"
                                    Content="{x:Bind Loc.FilterAll, Mode=OneWay}"
                                    Tag="All" Click="FilterButton_Click"
                                    MinWidth="0" Padding="10,4,10,4" />
                            <Button x:Name="FilterAvailableButton"
                                    Content="{x:Bind Loc.FilterAvailable, Mode=OneWay}"
                                    Tag="Available" Click="FilterButton_Click"
                                    MinWidth="0" Padding="10,4,10,4" />
                            <Button x:Name="FilterUntestedButton"
                                    Content="{x:Bind Loc.Untested, Mode=OneWay}"
                                    Tag="Untested" Click="FilterButton_Click"
                                    MinWidth="0" Padding="10,4,10,4" />
                            <Button x:Name="SortLatencyButton"
                                    Content="{x:Bind Loc.SortByLatency, Mode=OneWay}"
                                    Click="SortLatencyButton_Click"
                                    MinWidth="0" Padding="10,4,10,4" />
                        </StackPanel>

                        <!-- 延迟分级图例：告诉用户徽章颜色代表什么 -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="12"
                                    VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                         Fill="{ThemeResource StatusSuccessBrush}" />
                                <TextBlock Text="{x:Bind Loc.LatencyFast, Mode=OneWay}"
                                           Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                         Fill="{ThemeResource StatusWarningBrush}" />
                                <TextBlock Text="{x:Bind Loc.LatencyMedium, Mode=OneWay}"
                                           Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                         Fill="{ThemeResource StatusDangerBrush}" />
                                <TextBlock Text="{x:Bind Loc.LatencySlow, Mode=OneWay}"
                                           Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- 成员卡片列表 -->
                    <GridView x:Name="ProxyGridView"
                              Grid.Row="2"
                              Padding="14,0,14,12"
                              SelectionMode="Single"
                              SelectionChanged="ProxyGridView_SelectionChanged"
                              ItemContainerStyle="{StaticResource VCardItemContainerStyle}"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Grid MinWidth="300" MinHeight="64">
                                    <Border Background="{ThemeResource SurfaceCardBrush}"
                                            BorderBrush="{ThemeResource SurfaceCardStrokeBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource CardCornerRadius}"
                                            Padding="14,10" />
                                    <Border Background="{ThemeResource BrandSubtleBrush}"
                                            BorderBrush="{ThemeResource BrandPrimaryBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource CardCornerRadius}"
                                            Padding="14,10"
                                            Visibility="{Binding IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                    <Grid ColumnSpacing="12" Padding="14,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Width="3">
                                            <Border CornerRadius="2"
                                                    Background="{ThemeResource BrandPrimaryBrush}"
                                                    Visibility="{Binding IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name, Mode=OneWay}"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource CardTitleTextBlockStyle}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTipService.ToolTip="{Binding Name, Mode=OneWay}" />
                                                <Border Grid.Column="1" Style="{StaticResource TagBorderStyle}">
                                                    <TextBlock Text="{Binding Type, Mode=OneWay}"
                                                               Style="{StaticResource TagTextBlockStyle}" />
                                                </Border>
                                            </Grid>
                                            <Border Style="{StaticResource SemanticTagBorderStyle}"
                                                    HorizontalAlignment="Left"
                                                    Background="{Binding Latency, Mode=OneWay, Converter={StaticResource LatencyToBackground}}">
                                                <TextBlock Text="{Binding Latency, Mode=OneWay, Converter={StaticResource LatencyToText}}"
                                                           Foreground="{Binding Latency, Mode=OneWay, Converter={StaticResource LatencyToBrush}}"
                                                           Style="{StaticResource SemanticTagTextStyle}"
                                                           FontFamily="{StaticResource MonoFontFamily}" />
                                            </Border>
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Width="34" Height="30" Padding="0"
                                                ToolTipService.ToolTip="{Binding Test, Mode=OneWay}"
                                                Tag="{Binding Name, Mode=OneWay}"
                                                Click="TestButton_Click">
                                            <FontIcon Glyph="&#xE72C;"
                                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                      FontSize="13" />
                                        </Button>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <!-- 空状态：放在成员卡内部，单栏布局下也不会压到两张卡之间 -->
                    <StackPanel x:Name="EmptyStatePanel"
                                Grid.Row="2"
                                Style="{StaticResource EmptyStatePanelStyle}"
                                Visibility="Collapsed">
                        <FontIcon Style="{StaticResource EmptyStateIconStyle}" />
                        <TextBlock Text="{x:Bind Loc.NoProxies, Mode=OneWay}"
                                   Style="{StaticResource EmptyStateTextStyle}" />
                        <Button Content="{x:Bind Loc.GoToProfiles, Mode=OneWay}"
                                Click="GoToProfiles_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                MinWidth="120" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
