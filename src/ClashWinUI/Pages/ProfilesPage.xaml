<Page
    x:Class="ClashDotNetFramework.Pages.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="ProfilesPage_Loaded">

    <Grid Padding="24" AllowDrop="True" Drop="ProfileGrid_Drop" DragOver="ProfileGrid_DragOver">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding [Profiles]}" FontSize="28" FontWeight="SemiBold" />

        <Grid Grid.Row="1" Margin="0,16" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="UrlTextBox" PlaceholderText="{Binding [DownloadFromURL]}" VerticalAlignment="Center" />
            <Button x:Name="DownloadButton" Grid.Column="1" Content="{Binding [Download]}" Click="DownloadButton_Click" />
            <Button x:Name="UpdateAllButton" Grid.Column="2" Content="{Binding [UpdateAll]}" Click="UpdateAllButton_Click" />
            <Button x:Name="ImportButton" Grid.Column="3" Content="{Binding [Import]}" Click="ImportButton_Click" />
        </Grid>

        <ListView x:Name="ProfileItemListView" Grid.Row="2" SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="12,10" CornerRadius="6" Margin="0,2"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Select Profile" Click="SelectProfile_Click" />
                                <MenuFlyoutItem Text="Update Profile" Click="UpdateProfile_Click" />
                                <MenuFlyoutItem Text="Edit Profile" Click="EditProfile_Click" />
                                <MenuFlyoutItem Text="Duplicate Profile" Click="DuplicateProfile_Click" />
                                <MenuFlyoutItem Text="Go to URL" Click="GoToURL_Click" />
                                <MenuFlyoutItem Text="Profile Settings" Click="ProfileSettings_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Delete Profile" Click="DeleteProfile_Click" />
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Type}" Opacity="0.6" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="12" Opacity="0.7" Margin="0,4,0,0">
                                <TextBlock Text="{Binding ProxyCount, Converter={StaticResource ProfileTypeToString}}" />
                                <TextBlock Text="{Binding LastUpdate}" />
                            </StackPanel>
                        </StackPanel>
                        <SymbolIcon Grid.Column="1" Symbol="Accept" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>