<Page
    x:Class="ClashDotNetFramework.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Page.Resources>
        <!-- 小组件卡：统一外边距，栅格间距靠 margin 而不是 RowSpacing，
             这样切换布局后残留的空行不会撑出多余空白 -->
        <Style x:Key="DashboardCardStyle"
               TargetType="Border"
               BasedOn="{StaticResource WidgetCardStyle}">
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>

        <Style x:Key="CardHeaderIconStyle" TargetType="FontIcon">
            <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource IconSizeSmall}" />
            <Setter Property="Foreground" Value="{ThemeResource BrandPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 指标：标签 / 数值 / 单位 三层，数值一律等宽，避免跳动 -->
        <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="MetricValueStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource WidgetMetricTextStyle}">
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="MetricUnitStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="4,0,0,3" />
        </Style>

        <!-- 卡片内的次级数值（累计流量等）：比主数值小一档，仍用等宽 -->
        <Style x:Key="MetricSubValueStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource WidgetMetricTextStyle}">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSectionTitle}" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <!-- 运行信息这类“标签在上、数值在下”的小块 -->
        <Style x:Key="InfoValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="RowDividerStyle" TargetType="Rectangle">
            <Setter Property="Height" Value="1" />
            <Setter Property="Fill" Value="{ThemeResource SurfaceDividerBrush}" />
            <Setter Property="Margin" Value="0,12" />
        </Style>

        <!-- 代理模式选项：靠左侧选中标记表达状态，不覆盖按钮自身背景，
             这样悬停 / 按下的系统反馈仍然可用 -->
        <Style x:Key="ModeOptionButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="ModeOptionTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid"
          Padding="{StaticResource PageMargin}"
          SizeChanged="RootGrid_SizeChanged">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <!-- 宽窗口：左侧大图表卡跨两行，右侧两个开关/模式卡，底部三张统计卡 -->
                <VisualState x:Name="WideDashboard">
                </VisualState>

                <!-- 中等宽度：图表卡通栏，下面两列 -->
                <VisualState x:Name="MediumDashboard">
                    <VisualState.Setters>
                        <Setter Target="SpeedCard.(Grid.ColumnSpan)" Value="12" />
                        <Setter Target="SpeedCard.(Grid.RowSpan)" Value="1" />
                        <Setter Target="TogglesCard.(Grid.Row)" Value="1" />
                        <Setter Target="TogglesCard.(Grid.ColumnSpan)" Value="6" />
                        <Setter Target="TogglesCard.(Grid.Column)" Value="0" />
                        <Setter Target="TrafficCard.(Grid.Row)" Value="1" />
                        <Setter Target="TrafficCard.(Grid.Column)" Value="6" />
                        <Setter Target="TrafficCard.(Grid.ColumnSpan)" Value="6" />
                        <Setter Target="RuntimeCard.(Grid.Row)" Value="2" />
                        <Setter Target="RuntimeCard.(Grid.Column)" Value="0" />
                        <Setter Target="RuntimeCard.(Grid.ColumnSpan)" Value="6" />
                        <Setter Target="ModeCard.(Grid.Row)" Value="2" />
                        <Setter Target="ModeCard.(Grid.Column)" Value="6" />
                        <Setter Target="ModeCard.(Grid.ColumnSpan)" Value="6" />
                        <Setter Target="InfoCard.(Grid.Row)" Value="3" />
                        <Setter Target="InfoCard.(Grid.ColumnSpan)" Value="12" />
                        <Setter Target="InfoCard.(Grid.Column)" Value="0" />
                    </VisualState.Setters>
                </VisualState>

                <!-- 窄窗口：单列纵向堆叠 -->
                <VisualState x:Name="NarrowDashboard">
                    <VisualState.Setters>
                        <Setter Target="SpeedCard.(Grid.ColumnSpan)" Value="12" />
                        <Setter Target="SpeedCard.(Grid.RowSpan)" Value="1" />
                        <Setter Target="TogglesCard.(Grid.Row)" Value="1" />
                        <Setter Target="TogglesCard.(Grid.ColumnSpan)" Value="12" />
                        <Setter Target="TogglesCard.(Grid.Column)" Value="0" />
                        <Setter Target="TrafficCard.(Grid.Row)" Value="2" />
                        <Setter Target="TrafficCard.(Grid.Column)" Value="0" />
                        <Setter Target="TrafficCard.(Grid.ColumnSpan)" Value="12" />
                        <Setter Target="RuntimeCard.(Grid.Row)" Value="3" />
                        <Setter Target="RuntimeCard.(Grid.Column)" Value="0" />
                        <Setter Target="RuntimeCard.(Grid.ColumnSpan)" Value="12" />
                        <Setter Target="ModeCard.(Grid.Row)" Value="4" />
                        <Setter Target="ModeCard.(Grid.Column)" Value="0" />
                        <Setter Target="ModeCard.(Grid.ColumnSpan)" Value="12" />
                        <Setter Target="InfoCard.(Grid.Row)" Value="5" />
                        <Setter Target="InfoCard.(Grid.ColumnSpan)" Value="12" />
                        <Setter Target="InfoCard.(Grid.Column)" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页面标题 -->
        <TextBlock Text="{x:Bind Loc.Overview, Mode=OneWay}"
                   Style="{StaticResource PageTitleTextBlockStyle}" />

        <ScrollViewer Grid.Row="1"
                      Margin="0,16,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <!-- 12 栅格 × 6 行：宽窗口三行铺满，窄窗口退化为单列。
                 每格宽度为 *，卡片跨度随 VisualState 变化。 -->
            <Grid x:Name="CardGrid" Margin="0,0,-12,-12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ==================== 实时网速 ==================== -->
                <Border x:Name="SpeedCard"
                        Grid.Row="0" Grid.Column="0"
                        Grid.ColumnSpan="7" Grid.RowSpan="2"
                        Style="{StaticResource DashboardCardStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 标题行 -->
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE74B;" Style="{StaticResource CardHeaderIconStyle}" />
                                <TextBlock Text="{x:Bind Loc.DashboardSpeed, Mode=OneWay}"
                                           Style="{StaticResource CardTitleTextBlockStyle}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind Loc.TrafficWindow, Mode=OneWay}"
                                           Style="{StaticResource WidgetCaptionTextStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- 图例 -->
                            <StackPanel Orientation="Horizontal"
                                        Spacing="14"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="10" Height="10" CornerRadius="2"
                                            Background="{ThemeResource ChartUploadBrush}"
                                            VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind Loc.Upload, Mode=OneWay}"
                                               Style="{StaticResource WidgetCaptionTextStyle}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="10" Height="10" CornerRadius="2"
                                            Background="{ThemeResource ChartDownloadBrush}"
                                            VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind Loc.Download, Mode=OneWay}"
                                               Style="{StaticResource WidgetCaptionTextStyle}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- 主数值：下载 / 上传 -->
                        <Grid Grid.Row="1" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="{x:Bind Loc.DownloadSpeed, Mode=OneWay}"
                                           Style="{StaticResource MetricLabelStyle}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="DownloadSpeedText"
                                               Style="{StaticResource WidgetMetricLargeTextStyle}"
                                               Foreground="{ThemeResource ChartDownloadBrush}"
                                               Text="0.00" />
                                    <TextBlock x:Name="DownloadUnitText"
                                               Style="{StaticResource MetricUnitStyle}"
                                               Text="B/s" />
                                </StackPanel>
                            </StackPanel>

                            <Rectangle Grid.Column="1"
                                       Width="1"
                                       Fill="{ThemeResource SurfaceDividerBrush}"
                                       Margin="0,4" />

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{x:Bind Loc.UploadSpeed, Mode=OneWay}"
                                           Style="{StaticResource MetricLabelStyle}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="UploadSpeedText"
                                               Style="{StaticResource WidgetMetricLargeTextStyle}"
                                               Foreground="{ThemeResource ChartUploadBrush}"
                                               Text="0.00" />
                                    <TextBlock x:Name="UploadUnitText"
                                               Style="{StaticResource MetricUnitStyle}"
                                               Text="B/s" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- 趋势图 -->
                        <Grid Grid.Row="2" MinHeight="140">
                            <lvc:CartesianChart x:Name="TrafficChart"
                                                Background="Transparent"
                                                TooltipPosition="Hidden"
                                                LegendPosition="Hidden" />

                            <!-- 无流量时的引导，避免只剩一条贴着 0 的平线 -->
                            <TextBlock x:Name="TrafficEmptyHint"
                                       Text="{x:Bind Loc.WaitingTraffic, Mode=OneWay}"
                                       Style="{StaticResource WidgetCaptionTextStyle}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- ==================== 快捷开关 ==================== -->
                <Border x:Name="TogglesCard"
                        Grid.Row="0" Grid.Column="7"
                        Grid.ColumnSpan="5"
                        Style="{StaticResource DashboardCardStyle}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE713;" Style="{StaticResource CardHeaderIconStyle}" />
                            <TextBlock Text="{x:Bind Loc.DashboardToggles, Mode=OneWay}"
                                       Style="{StaticResource CardTitleTextBlockStyle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- 系统代理 -->
                        <Grid Grid.Row="1" Margin="0,8,0,0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Loc.SystemProxy, Mode=OneWay}"
                                           Style="{StaticResource ModeOptionTextStyle}" />
                                <TextBlock Text="{x:Bind Loc.SystemProxyHint, Mode=OneWay}"
                                           Style="{StaticResource WidgetCaptionTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleSwitch x:Name="SystemProxySwitch"
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          OnContent=""
                                          OffContent=""
                                          Toggled="SystemProxySwitch_Toggled" />
                        </Grid>

                        <Rectangle Grid.Row="2" Style="{StaticResource RowDividerStyle}" Margin="0,6" />

                        <!-- 虚拟网卡 / TUN -->
                        <Grid Grid.Row="3" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Loc.TunMode, Mode=OneWay}"
                                           Style="{StaticResource ModeOptionTextStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                                    <FontIcon Glyph="&#xE7BA;"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              FontSize="11"
                                              Foreground="{ThemeResource StatusWarningBrush}"
                                              VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind Loc.TunAdminHint, Mode=OneWay}"
                                               Style="{StaticResource WidgetCaptionTextStyle}"
                                               Foreground="{ThemeResource StatusWarningBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                            <ToggleSwitch x:Name="TunModeSwitch"
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          OnContent=""
                                          OffContent=""
                                          Toggled="TunModeSwitch_Toggled"
                                          ToolTipService.ToolTip="{x:Bind Loc.TunModeHint, Mode=OneWay}" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- ==================== 代理模式 ==================== -->
                <Border x:Name="ModeCard"
                        Grid.Row="1" Grid.Column="7"
                        Grid.ColumnSpan="5"
                        Style="{StaticResource DashboardCardStyle}">
                    <Grid RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE774;" Style="{StaticResource CardHeaderIconStyle}" />
                            <TextBlock Text="{x:Bind Loc.ProxyMode, Mode=OneWay}"
                                       Style="{StaticResource CardTitleTextBlockStyle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,6,0,0" Spacing="2">
                            <Button x:Name="RuleModeButton"
                                    Tag="Rule"
                                    Click="ModeButton_Click"
                                    Style="{StaticResource ModeOptionButtonStyle}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="16" Height="16" VerticalAlignment="Center">
                                        <Ellipse Width="13" Height="13"
                                                 Stroke="{ThemeResource TextTertiaryBrush}"
                                                 StrokeThickness="1" />
                                        <FontIcon x:Name="RuleModeCheck"
                                                  Glyph="&#xE73E;"
                                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                  FontSize="12"
                                                  Foreground="{ThemeResource BrandPrimaryBrush}"
                                                  Opacity="0" />
                                    </Grid>
                                    <TextBlock x:Name="RuleModeText"
                                               Grid.Column="1"
                                               Text="{x:Bind Loc.Rule, Mode=OneWay}"
                                               Style="{StaticResource ModeOptionTextStyle}" />
                                </Grid>
                            </Button>

                            <Button x:Name="GlobalModeButton"
                                    Tag="Global"
                                    Click="ModeButton_Click"
                                    Style="{StaticResource ModeOptionButtonStyle}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="16" Height="16" VerticalAlignment="Center">
                                        <Ellipse Width="13" Height="13"
                                                 Stroke="{ThemeResource TextTertiaryBrush}"
                                                 StrokeThickness="1" />
                                        <FontIcon x:Name="GlobalModeCheck"
                                                  Glyph="&#xE73E;"
                                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                  FontSize="12"
                                                  Foreground="{ThemeResource BrandPrimaryBrush}"
                                                  Opacity="0" />
                                    </Grid>
                                    <TextBlock x:Name="GlobalModeText"
                                               Grid.Column="1"
                                               Text="{x:Bind Loc.Global, Mode=OneWay}"
                                               Style="{StaticResource ModeOptionTextStyle}" />
                                </Grid>
                            </Button>

                            <Button x:Name="DirectModeButton"
                                    Tag="Direct"
                                    Click="ModeButton_Click"
                                    Style="{StaticResource ModeOptionButtonStyle}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="16" Height="16" VerticalAlignment="Center">
                                        <Ellipse Width="13" Height="13"
                                                 Stroke="{ThemeResource TextTertiaryBrush}"
                                                 StrokeThickness="1" />
                                        <FontIcon x:Name="DirectModeCheck"
                                                  Glyph="&#xE73E;"
                                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                  FontSize="12"
                                                  Foreground="{ThemeResource BrandPrimaryBrush}"
                                                  Opacity="0" />
                                    </Grid>
                                    <TextBlock x:Name="DirectModeText"
                                               Grid.Column="1"
                                               Text="{x:Bind Loc.Direct, Mode=OneWay}"
                                               Style="{StaticResource ModeOptionTextStyle}" />
                                </Grid>
                            </Button>
                        </StackPanel>

                        <TextBlock x:Name="ModeHintText"
                                   Grid.Row="2"
                                   Style="{StaticResource WidgetCaptionTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="8,6,8,0" />
                    </Grid>
                </Border>

                <!-- ==================== 流量与连接 ==================== -->
                <Border x:Name="TrafficCard"
                        Grid.Row="2" Grid.Column="0"
                        Grid.ColumnSpan="4"
                        Style="{StaticResource DashboardCardStyle}">
                    <Grid RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE71B;" Style="{StaticResource CardHeaderIconStyle}" />
                            <TextBlock Text="{x:Bind Loc.DashboardTraffic, Mode=OneWay}"
                                       Style="{StaticResource CardTitleTextBlockStyle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- 主数值：活跃连接 -->
                        <StackPanel Grid.Row="1" Margin="0,8,0,0">
                            <TextBlock Text="{x:Bind Loc.ActiveConnections, Mode=OneWay}"
                                       Style="{StaticResource MetricLabelStyle}" />
                            <TextBlock x:Name="ConnectionCountText"
                                       Style="{StaticResource WidgetMetricLargeTextStyle}"
                                       Text="0" />
                        </StackPanel>

                        <Rectangle Grid.Row="2" Style="{StaticResource RowDividerStyle}" Margin="0,10" />

                        <!-- 累计上传 / 下载 -->
                        <Grid Grid.Row="3" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Bind Loc.TotalDownload, Mode=OneWay}"
                                           Style="{StaticResource MetricLabelStyle}" />
                                <TextBlock x:Name="TotalDownloadText"
                                           Style="{StaticResource MetricSubValueStyle}"
                                           Text="0.00 B" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Bind Loc.TotalUpload, Mode=OneWay}"
                                           Style="{StaticResource MetricLabelStyle}" />
                                <TextBlock x:Name="TotalUploadText"
                                           Style="{StaticResource MetricSubValueStyle}"
                                           Text="0.00 B" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ==================== 运行状态 ==================== -->
                <Border x:Name="RuntimeCard"
                        Grid.Row="2" Grid.Column="4"
                        Grid.ColumnSpan="4"
                        Style="{StaticResource DashboardCardStyle}">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 标题 + 状态药丸（两套配色随状态切换，颜色全部走资源） -->
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE72C;" Style="{StaticResource CardHeaderIconStyle}" />
                                <TextBlock Text="{x:Bind Loc.DashboardRuntime, Mode=OneWay}"
                                           Style="{StaticResource CardTitleTextBlockStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <Grid HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border x:Name="ConnectedPill"
                                        Background="{ThemeResource StatusSuccessSubtleBrush}"
                                        CornerRadius="{StaticResource PillCornerRadius}"
                                        Padding="8,3">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="6" Height="6"
                                                 Fill="{ThemeResource StatusSuccessBrush}"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind Loc.Connected, Mode=OneWay}"
                                                   FontSize="{StaticResource FontSizeMicro}"
                                                   Foreground="{ThemeResource StatusSuccessBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <Border x:Name="DisconnectedPill"
                                        Background="{ThemeResource StatusNeutralSubtleBrush}"
                                        CornerRadius="{StaticResource PillCornerRadius}"
                                        Padding="8,3"
                                        Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="6" Height="6"
                                                 Fill="{ThemeResource StatusNeutralBrush}"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind Loc.Disconnected, Mode=OneWay}"
                                                   FontSize="{StaticResource FontSizeMicro}"
                                                   Foreground="{ThemeResource StatusNeutralBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- 主数值：运行时间 -->
                        <StackPanel Grid.Row="1" Margin="0,6,0,0">
                            <TextBlock Text="{x:Bind Loc.Uptime, Mode=OneWay}"
                                       Style="{StaticResource MetricLabelStyle}" />
                            <TextBlock x:Name="UptimeText"
                                       Style="{StaticResource WidgetMetricLargeTextStyle}"
                                       Text="00:00:00" />
                        </StackPanel>

                        <!-- 内核版本 -->
                        <Grid Grid.Row="2" Margin="0,4,0,0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Loc.CoreVersion, Mode=OneWay}"
                                       Style="{StaticResource MetricLabelStyle}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="CoreVersionText"
                                       Grid.Column="1"
                                       Style="{StaticResource InfoValueStyle}"
                                       HorizontalAlignment="Right"
                                       Text="-" />
                        </Grid>

                        <Button x:Name="CoreButton"
                                Grid.Row="3"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Stretch"
                                Content="{x:Bind Loc.StartCore, Mode=OneWay}"
                                Click="CoreButton_Click"
                                Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                </Border>

                <!-- ==================== 运行信息 ==================== -->
                <Border x:Name="InfoCard"
                        Grid.Row="2" Grid.Column="8"
                        Grid.ColumnSpan="4"
                        Style="{StaticResource DashboardCardStyle}">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8A5;" Style="{StaticResource CardHeaderIconStyle}" />
                            <TextBlock Text="{x:Bind Loc.RuntimeInfo, Mode=OneWay}"
                                       Style="{StaticResource CardTitleTextBlockStyle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,6,0,0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Loc.MixedPort, Mode=OneWay}"
                                       Style="{StaticResource MetricLabelStyle}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="MixedPortText"
                                       Grid.Column="1"
                                       Style="{StaticResource InfoValueStyle}"
                                       HorizontalAlignment="Right"
                                       Text="-" />
                        </Grid>

                        <Grid Grid.Row="2" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Loc.AllowLAN, Mode=OneWay}"
                                       Style="{StaticResource MetricLabelStyle}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="AllowLanText"
                                       Grid.Column="1"
                                       Style="{StaticResource InfoValueStyle}"
                                       HorizontalAlignment="Right"
                                       Text="-" />
                        </Grid>

                        <Grid Grid.Row="3" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Loc.IPV6, Mode=OneWay}"
                                       Style="{StaticResource MetricLabelStyle}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="Ipv6Text"
                                       Grid.Column="1"
                                       Style="{StaticResource InfoValueStyle}"
                                       HorizontalAlignment="Right"
                                       Text="-" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
