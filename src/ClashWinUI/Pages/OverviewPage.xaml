<Page
    x:Class="ClashDotNetFramework.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Page.Resources>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Page.Resources>

    <Grid Padding="{StaticResource PageMargin}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页面标题 -->
        <TextBlock Text="{x:Bind Loc.Overview, Mode=OneWay}"
                   Style="{StaticResource PageTitleTextBlockStyle}" />

        <!-- 控制栏 -->
        <Border Grid.Row="1"
                Style="{StaticResource CardBorderStyle}"
                Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" Spacing="28" VerticalAlignment="Center">
                <ToggleSwitch x:Name="SystemProxySwitch"
                              Header="{x:Bind Loc.SystemProxy, Mode=OneWay}"
                              Toggled="SystemProxySwitch_Toggled"
                              OnContent="{x:Bind Loc.On, Mode=OneWay}"
                              OffContent="{x:Bind Loc.Off, Mode=OneWay}" />
                <ToggleSwitch x:Name="TunModeSwitch"
                              Header="{x:Bind Loc.TunMode, Mode=OneWay}"
                              Toggled="TunModeSwitch_Toggled"
                              OnContent="{x:Bind Loc.On, Mode=OneWay}"
                              OffContent="{x:Bind Loc.Off, Mode=OneWay}" />
                <Button x:Name="CoreButton"
                        Content="{x:Bind Loc.StartCore, Mode=OneWay}"
                        Click="CoreButton_Click"
                        MinWidth="120"
                        VerticalAlignment="Bottom" />
            </StackPanel>
        </Border>

        <!-- KPI 卡片 -->
        <Grid Grid.Row="2"
              ColumnSpacing="12"
              Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}"
                               Text="{x:Bind Loc.UploadSpeed, Mode=OneWay}" />
                    <TextBlock x:Name="UploadSpeedText"
                               Style="{StaticResource StatValue}"
                               Text="0.00 B/s" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}"
                               Text="{x:Bind Loc.DownloadSpeed, Mode=OneWay}" />
                    <TextBlock x:Name="DownloadSpeedText"
                               Style="{StaticResource StatValue}"
                               Text="0.00 B/s" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}"
                               Text="{x:Bind Loc.ActiveConnections, Mode=OneWay}" />
                    <TextBlock x:Name="ConnectionCountText"
                               Style="{StaticResource StatValue}"
                               Text="0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}"
                               Text="{x:Bind Loc.Uptime, Mode=OneWay}" />
                    <TextBlock x:Name="UptimeText"
                               Style="{StaticResource StatValue}"
                               Text="00:00:00" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 图表 + 运行信息 -->
        <Grid Grid.Row="3"
              ColumnSpacing="12"
              Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 流量趋势图表 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Loc.TrafficTrend, Mode=OneWay}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="14"
                                    VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="10" Height="10" CornerRadius="2"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind Loc.Upload, Mode=OneWay}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="10" Height="10" CornerRadius="2"
                                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                        VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind Loc.Download, Mode=OneWay}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <lvc:CartesianChart Grid.Row="1"
                                        Margin="0,12,0,0"
                                        Series="{x:Bind Series}"
                                        TooltipPosition="Hidden"
                                        LegendPosition="Hidden" />
                </Grid>
            </Border>

            <!-- 运行信息 -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{x:Bind Loc.RuntimeInfo, Mode=OneWay}"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <TextBlock Style="{StaticResource InfoLabel}"
                                   Text="{x:Bind Loc.ProxyMode, Mode=OneWay}" />
                        <TextBlock x:Name="ModeText"
                                   Grid.Column="1"
                                   Style="{StaticResource InfoValue}"
                                   Text="-" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <TextBlock Style="{StaticResource InfoLabel}"
                                   Text="{x:Bind Loc.MixedPort, Mode=OneWay}" />
                        <TextBlock x:Name="MixedPortText"
                                   Grid.Column="1"
                                   Style="{StaticResource InfoValue}"
                                   Text="-" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <TextBlock Style="{StaticResource InfoLabel}"
                                   Text="{x:Bind Loc.TotalUpload, Mode=OneWay}" />
                        <TextBlock x:Name="TotalUploadText"
                                   Grid.Column="1"
                                   Style="{StaticResource InfoValue}"
                                   Text="0.00 B" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <TextBlock Style="{StaticResource InfoLabel}"
                                   Text="{x:Bind Loc.TotalDownload, Mode=OneWay}" />
                        <TextBlock x:Name="TotalDownloadText"
                                   Grid.Column="1"
                                   Style="{StaticResource InfoValue}"
                                   Text="0.00 B" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <TextBlock Style="{StaticResource InfoLabel}"
                                   Text="{x:Bind Loc.AllowLAN, Mode=OneWay}" />
                        <TextBlock x:Name="AllowLanText"
                                   Grid.Column="1"
                                   Style="{StaticResource InfoValue}"
                                   Text="-" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <TextBlock Style="{StaticResource InfoLabel}"
                                   Text="{x:Bind Loc.IPV6, Mode=OneWay}" />
                        <TextBlock x:Name="Ipv6Text"
                                   Grid.Column="1"
                                   Style="{StaticResource InfoValue}"
                                   Text="-" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <TextBlock Style="{StaticResource InfoLabel}"
                                   Text="{x:Bind Loc.CoreVersion, Mode=OneWay}" />
                        <TextBlock x:Name="CoreVersionText"
                                   Grid.Column="1"
                                   Style="{StaticResource InfoValue}"
                                   Text="-" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
