<Page
    x:Class="ClashDotNetFramework.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Page.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Page.Resources>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding [Overview]}" FontSize="28" FontWeight="SemiBold" />

        <!-- 控制栏 -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" Spacing="28" VerticalAlignment="Center">
                <ToggleSwitch x:Name="SystemProxySwitch" Header="{Binding [SystemProxy]}" Toggled="SystemProxySwitch_Toggled" />
                <ToggleSwitch x:Name="TunModeSwitch" Header="{Binding [TunMode]}" Toggled="TunModeSwitch_Toggled" />
                <Button x:Name="CoreButton" Content="{Binding [StartCore]}" Click="CoreButton_Click" MinWidth="120" VerticalAlignment="Bottom" />
            </StackPanel>
        </Border>

        <!-- KPI 卡片 -->
        <Grid Grid.Row="2" ColumnSpacing="12" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}" Text="{Binding [UploadSpeed]}" />
                    <TextBlock x:Name="UploadSpeedText" Style="{StaticResource StatValue}" Text="0.00 B/s" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}" Text="{Binding [DownloadSpeed]}" />
                    <TextBlock x:Name="DownloadSpeedText" Style="{StaticResource StatValue}" Text="0.00 B/s" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}" Text="{Binding [ActiveConnections]}" />
                    <TextBlock x:Name="ConnectionCountText" Style="{StaticResource StatValue}" Text="0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}" Text="{Binding [Uptime]}" />
                    <TextBlock x:Name="UptimeText" Style="{StaticResource StatValue}" Text="00:00:00" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 图表 + 运行信息 -->
        <Grid Grid.Row="3" ColumnSpacing="12" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding [TrafficTrend]}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="10" Height="10" CornerRadius="2" Background="DeepSkyBlue" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding [Upload]}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="10" Height="10" CornerRadius="2" Background="MediumSeaGreen" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding [Download]}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <lvc:CartesianChart Grid.Row="1"
                                        Margin="0,12,0,0"
                                        Series="{x:Bind Series}"
                                        TooltipPosition="Hidden"
                                        LegendPosition="Hidden" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding [RuntimeInfo]}" FontSize="16" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Style="{StaticResource InfoLabel}" Text="{Binding [ProxyMode]}" />
                        <TextBlock x:Name="ModeText" Grid.Column="1" Style="{StaticResource InfoValue}" Text="-" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Style="{StaticResource InfoLabel}" Text="{Binding [MixedPort]}" />
                        <TextBlock x:Name="MixedPortText" Grid.Column="1" Style="{StaticResource InfoValue}" Text="-" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Style="{StaticResource InfoLabel}" Text="{Binding [TotalUpload]}" />
                        <TextBlock x:Name="TotalUploadText" Grid.Column="1" Style="{StaticResource InfoValue}" Text="0.00 B" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Style="{StaticResource InfoLabel}" Text="{Binding [TotalDownload]}" />
                        <TextBlock x:Name="TotalDownloadText" Grid.Column="1" Style="{StaticResource InfoValue}" Text="0.00 B" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Style="{StaticResource InfoLabel}" Text="{Binding [AllowLAN]}" />
                        <TextBlock x:Name="AllowLanText" Grid.Column="1" Style="{StaticResource InfoValue}" Text="-" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Style="{StaticResource InfoLabel}" Text="{Binding [IPV6]}" />
                        <TextBlock x:Name="Ipv6Text" Grid.Column="1" Style="{StaticResource InfoValue}" Text="-" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Style="{StaticResource InfoLabel}" Text="{Binding [CoreVersion]}" />
                        <TextBlock x:Name="CoreVersionText" Grid.Column="1" Style="{StaticResource InfoValue}" Text="-" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>