<Page
    x:Class="ClashDotNetFramework.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Page.Resources>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="StatUnit" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Page.Resources>

    <Grid Padding="{StaticResource PageMargin}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页面标题 -->
        <TextBlock Text="{x:Bind Loc.Overview, Mode=OneWay}"
                   Style="{StaticResource PageTitleTextBlockStyle}" />

        <!-- 控制栏：状态 + 开关 + 主操作 -->
        <Border Grid.Row="1"
                Style="{StaticResource CardBorderStyle}"
                Margin="0,16,0,0"
                Padding="20,12,20,12">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 内核状态（颜色由代码按运行状态切换） -->
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Ellipse x:Name="CoreStatusLight"
                             Width="10" Height="10"
                             Fill="{ThemeResource TextTertiaryBrush}" />
                    <TextBlock x:Name="CoreStatusText"
                               Text="{x:Bind Loc.Disconnected, Mode=OneWay}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Border x:Name="ModeBadge"
                            Background="{ThemeResource BrandSubtleBrush}"
                            CornerRadius="4"
                            Padding="8,3,8,3"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="ModeBadgeText"
                                   Text="{x:Bind Loc.Rule, Mode=OneWay}"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextPrimaryBrush}" />
                    </Border>
                </StackPanel>

                <!-- 代理方式开关 -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal" Spacing="24"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ToggleSwitch x:Name="SystemProxySwitch"
                                  Header="{x:Bind Loc.SystemProxy, Mode=OneWay}"
                                  Toggled="SystemProxySwitch_Toggled"
                                  OnContent="{x:Bind Loc.On, Mode=OneWay}"
                                  OffContent="{x:Bind Loc.Off, Mode=OneWay}" />
                    <ToggleSwitch x:Name="TunModeSwitch"
                                  Header="{x:Bind Loc.TunMode, Mode=OneWay}"
                                  Toggled="TunModeSwitch_Toggled"
                                  OnContent="{x:Bind Loc.On, Mode=OneWay}"
                                  OffContent="{x:Bind Loc.Off, Mode=OneWay}" />
                </StackPanel>

                <!-- 主操作 -->
                <Button x:Name="CoreButton"
                        Grid.Column="2"
                        Content="{x:Bind Loc.StartCore, Mode=OneWay}"
                        Click="CoreButton_Click"
                        MinWidth="120"
                        Style="{StaticResource AccentButtonStyle}"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- KPI 卡片：下载/上传为主，连接/时长/累计为辅 -->
        <Grid Grid.Row="2"
              ColumnSpacing="12" RowSpacing="12"
              Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 主指标：下载 -->
            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                    Style="{StaticResource CardBorderStyle}" Padding="16,12,16,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74B;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  FontSize="12" Foreground="{ThemeResource BrandPrimaryBrush}" />
                        <TextBlock Style="{StaticResource StatLabel}" Text="{x:Bind Loc.DownloadSpeed, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock x:Name="DownloadSpeedText"
                                   Style="{StaticResource StatValue}"
                                   Foreground="{ThemeResource BrandPrimaryBrush}"
                                   Text="0.00" />
                        <TextBlock x:Name="DownloadUnitText" Style="{StaticResource StatUnit}" Text="B/s" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 主指标：上传 -->
            <Border Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2"
                    Style="{StaticResource CardBorderStyle}" Padding="16,12,16,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74A;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock Style="{StaticResource StatLabel}" Text="{x:Bind Loc.UploadSpeed, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock x:Name="UploadSpeedText"
                                   Style="{StaticResource StatValue}"
                                   Text="0.00" />
                        <TextBlock x:Name="UploadUnitText" Style="{StaticResource StatUnit}" Text="B/s" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 次指标 -->
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="12,10,12,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}" Text="{x:Bind Loc.ActiveConnections, Mode=OneWay}" />
                    <TextBlock x:Name="ConnectionCountText" Style="{StaticResource StatValue}"
                               FontSize="22" Text="0" />
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="12,10,12,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}" Text="{x:Bind Loc.Uptime, Mode=OneWay}" />
                    <TextBlock x:Name="UptimeText" Style="{StaticResource StatValue}"
                               FontSize="22" Text="00:00:00" />
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                    Style="{StaticResource CardBorderStyle}" Padding="12,10,12,10">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="{x:Bind Loc.TotalDownload, Mode=OneWay}" />
                        <TextBlock x:Name="TotalDownloadText" Style="{StaticResource StatValue}"
                                   FontSize="18" Text="0.00 B" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource StatLabel}" Text="{x:Bind Loc.TotalUpload, Mode=OneWay}" />
                        <TextBlock x:Name="TotalUploadText" Style="{StaticResource StatValue}"
                                   FontSize="18" Text="0.00 B" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 图表 + 运行信息 -->
        <Grid Grid.Row="3"
              ColumnSpacing="12"
              Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 流量趋势图表 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Loc.TrafficTrend, Mode=OneWay}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind Loc.TrafficWindow, Mode=OneWay}"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextTertiaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="14"
                                    VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="10" Height="10" CornerRadius="2"
                                        Background="{ThemeResource ChartUploadBrush}"
                                        VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind Loc.Upload, Mode=OneWay}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="10" Height="10" CornerRadius="2"
                                        Background="{ThemeResource ChartDownloadBrush}"
                                        VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind Loc.Download, Mode=OneWay}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <lvc:CartesianChart x:Name="TrafficChart" Grid.Row="1"
                                        Margin="0,8,0,0"
                                        Series="{x:Bind Series}"
                                        TooltipPosition="Hidden"
                                        LegendPosition="Hidden" />

                    <!-- 无流量时的引导，避免只剩一条贴着 0 的平线 -->
                    <TextBlock x:Name="TrafficEmptyHint"
                               Grid.Row="1"
                               Text="{x:Bind Loc.WaitingTraffic, Mode=OneWay}"
                               FontSize="12"
                               Foreground="{ThemeResource TextTertiaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Visible" />
                </Grid>
            </Border>

            <!-- 运行信息 -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{x:Bind Loc.RuntimeInfo, Mode=OneWay}"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <TextBlock Style="{StaticResource InfoLabel}"
                                   Text="{x:Bind Loc.ProxyMode, Mode=OneWay}" />
                        <TextBlock x:Name="ModeText"
                                   Grid.Column="1"
                                   Style="{StaticResource InfoValue}"
                                   Text="-" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <TextBlock Style="{StaticResource InfoLabel}"
                                   Text="{x:Bind Loc.MixedPort, Mode=OneWay}" />
                        <TextBlock x:Name="MixedPortText"
                                   Grid.Column="1"
                                   Style="{StaticResource InfoValue}"
                                   Text="-" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <TextBlock Style="{StaticResource InfoLabel}"
                                   Text="{x:Bind Loc.AllowLAN, Mode=OneWay}" />
                        <TextBlock x:Name="AllowLanText"
                                   Grid.Column="1"
                                   Style="{StaticResource InfoValue}"
                                   Text="-" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <TextBlock Style="{StaticResource InfoLabel}"
                                   Text="{x:Bind Loc.IPV6, Mode=OneWay}" />
                        <TextBlock x:Name="Ipv6Text"
                                   Grid.Column="1"
                                   Style="{StaticResource InfoValue}"
                                   Text="-" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <TextBlock Style="{StaticResource InfoLabel}"
                                   Text="{x:Bind Loc.CoreVersion, Mode=OneWay}" />
                        <TextBlock x:Name="CoreVersionText"
                                   Grid.Column="1"
                                   Style="{StaticResource InfoValue}"
                                   Text="-" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
