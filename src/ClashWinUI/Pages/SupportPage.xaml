<Page x:Class="ClashDotNetFramework.Pages.SupportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Loaded="SupportPage_Loaded">

    <ScrollViewer Padding="{StaticResource PageMarginCompact}">
        <StackPanel Spacing="16">
            <!-- 页面标题 -->
            <TextBlock Text="{x:Bind Loc.Support, Mode=OneWay}"
                       Style="{StaticResource PageTitleTextBlockStyle}" />

            <!-- 开发者 -->
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind Loc.Developer, Mode=OneWay}"
                           Style="{StaticResource SectionHeaderTextBlockStyle}" />
                <TextBlock Text="TheWanderingCoel"
                           Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
            </StackPanel>

            <!-- 帮助链接 -->
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind Loc.Help, Mode=OneWay}"
                           Style="{StaticResource SectionHeaderTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <HyperlinkButton Content="Github"
                                     NavigateUri="https://github.com/ClashDotNetFramework/ClashDotNetFramework" />
                    <HyperlinkButton Content="Discord"
                                     NavigateUri="https://discord.gg/vsDxzJ9R75" />
                    <HyperlinkButton Content="Telegram"
                                     NavigateUri="https://t.me/ClashDotNetFramework" />
                </StackPanel>
            </StackPanel>

            <!-- 致谢 -->
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind Loc.Credits, Mode=OneWay}"
                           Style="{StaticResource SectionHeaderTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <HyperlinkButton Content="Clash"
                                     NavigateUri="https://github.com/Dreamacro/clash" />
                    <HyperlinkButton Content="Clash-Dashboard"
                                     NavigateUri="https://github.com/Dreamacro/clash-dashboard" />
                    <HyperlinkButton Content="ClashX"
                                     NavigateUri="https://github.com/yichengchen/clashX" />
                    <HyperlinkButton Content="Clash For Windows"
                                     NavigateUri="https://github.com/Fndroid/clash_for_windows_pkg" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                    <HyperlinkButton Content="Netch"
                                     NavigateUri="https://github.com/NetchX/Netch" />
                    <HyperlinkButton Content="mihomo"
                                     NavigateUri="https://github.com/MetaCubeX/mihomo" />
                    <HyperlinkButton Content="Yacd"
                                     NavigateUri="https://github.com/haishanh/yacd" />
                </StackPanel>
            </StackPanel>

            <!-- 捐赠 -->
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind Loc.Donate, Mode=OneWay}"
                           Style="{StaticResource SectionHeaderTextBlockStyle}" />
                <HyperlinkButton Content="Crypto Currency"
                                 NavigateUri="https://u.nu/leudd"
                                 HorizontalAlignment="Left" />
            </StackPanel>

            <!-- 广告：仅在成功拉取到图片后显示整块，避免只留下空标题 -->
            <StackPanel x:Name="AdvertisementPanel" Spacing="8" Visibility="Collapsed">
                <TextBlock Text="{x:Bind Loc.Advertisement, Mode=OneWay}"
                           Style="{StaticResource SectionHeaderTextBlockStyle}" />
                <Image x:Name="MajorAdvertisement" Width="690" Height="165" Stretch="Fill"
                       HorizontalAlignment="Left" Tapped="Advertisement_Tapped" Visibility="Collapsed" />
                <Image x:Name="MinorAdvertisement" Width="690" Height="165" Stretch="Fill"
                       HorizontalAlignment="Left" Tapped="Advertisement_Tapped" Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
