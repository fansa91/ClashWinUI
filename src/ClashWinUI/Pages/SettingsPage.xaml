<Page
    x:Class="ClashDotNetFramework.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="SettingsPage_Loaded">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="20" MaxWidth="700" HorizontalAlignment="Left">
            <TextBlock Text="{Binding [Settings]}" FontSize="28" FontWeight="SemiBold" />

            <StackPanel Spacing="12">
                <ToggleSwitch x:Name="StartWithWindows" Header="{Binding [StartWithWindows]}" Toggled="StartWithWindows_Toggled" />
                <ToggleSwitch x:Name="AllowLAN" Header="{Binding [AllowLAN]}" Toggled="AllowLAN_Toggled" />
                <ToggleSwitch x:Name="IPV6" Header="{Binding [IPV6]}" Toggled="IPV6_Toggled" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="{Binding [Theme]}" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <RadioButton x:Name="ClassicTheme" GroupName="Theme" Content="{Binding [Classic]}" Checked="ClassicTheme_Click" />
                    <RadioButton x:Name="ModernTheme" GroupName="Theme" Content="{Binding [Modern]}" Checked="ModernTheme_Click" />
                    <RadioButton x:Name="DarkTheme" GroupName="Theme" Content="{Binding [Dark]}" Checked="DarkTheme_Click" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="{Binding [Language]}" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <RadioButton x:Name="EnglishLanguage" GroupName="Language" Content="{Binding [English]}" Checked="EnglishLanguage_Click" />
                    <RadioButton x:Name="ChineseLanguage" GroupName="Language" Content="{Binding [Chinese]}" Checked="ChineseLanguage_Click" />
                    <RadioButton x:Name="JapaneseLanguage" GroupName="Language" Content="{Binding [Japanese]}" Checked="JapaneseLanguage_Click" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="{Binding [ControllerPort]}" FontWeight="SemiBold" />
                <Button x:Name="ControllerPort" Click="ControllerPort_Click" />
                <TextBlock Text="{Binding [MixedPort]}" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock x:Name="MixedPort" />
                <TextBlock Text="{Binding [LogLevel]}" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock x:Name="LogLevel" />
                <TextBlock x:Name="Version" Opacity="0.7" Margin="0,8,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="CheckMMDBUpdate" Content="{Binding [CheckMMDBUpdate]}" Click="CheckMMDBUpdate_Click" />
                <Button Content="{Binding [UWPLoopback]}" Click="UWPLoopback_Click" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="{Binding [ResetAllSettings]}" Click="ResetAllSettings_Click" />
                <Button x:Name="UpdateButton" Content="{Binding [Update]}" Visibility="Collapsed" Click="UpdateButton_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>