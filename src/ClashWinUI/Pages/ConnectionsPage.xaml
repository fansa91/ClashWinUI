<Page
    x:Class="ClashDotNetFramework.Pages.ConnectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="ConnectionsPage_Loaded"
    Unloaded="ConnectionsPage_Unloaded">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding [Connections]}" FontSize="28" FontWeight="SemiBold" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,16">
            <Button Content="{Binding [CloseAll]}" Click="CloseAllButton_Click" MinWidth="90" />
            <TextBlock x:Name="TotalTraffic" VerticalAlignment="Center" Opacity="0.7" />
        </StackPanel>

        <ListView x:Name="ConnectionItemListView" Grid.Row="2" SelectionMode="None"
                  IsItemClickEnabled="True" ItemClick="ConnectionItemListView_ItemClick">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding TargetHost}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Network}" Opacity="0.7" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Speed}" Opacity="0.7" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{Binding Time}" Opacity="0.7" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>