<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ClashDotNetFramework</RootNamespace>
    <AssemblyName>ClashDotNetFramework</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- FireWallHelper 仅拷贝其输出、不引用程序集，允许主项目为非自包含时引用自包含 exe -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <!-- 不要再用"预创建空 .xbf 占位符"的方式绕过 XAML 编译器错误：
       那会把编译失败伪装成构建成功，运行时因加载 0 字节 XBF 直接崩溃。
       若再次出现 MSB3030 / WMC9999，应修复 XAML 本身。 -->

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="CoelWu.Clash.SDK" Version="1.3.9" />
    <PackageReference Include="CoelWu.Garbage.Collector" Version="1.0.0" />
    <PackageReference Include="HMBSbige.SingleInstance" Version="1.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Reactive" Version="4.4.1" />
    <PackageReference Include="WindowsProxy" Version="5.0.3" />
    <PackageReference Include="WindowsFirewallHelper" Version="2.0.4.70-beta2" />
    <PackageReference Include="YamlDotNet" Version="9.1.4" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" Condition="'$(DisableToolkit)' == 'true'" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WinUI" Version="2.0.5" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="4.7.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\*.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FireWallHelper\FireWallHelper.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <Target Name="BundleHelpersAndNative" AfterTargets="Build">
    <ItemGroup>
      <FireWallHelperOut Include="..\FireWallHelper\bin\$(Configuration)\net10.0-windows\win-x64\**\*.*" />
      <NativeFiles Include="..\..\native\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(FireWallHelperOut)" DestinationFiles="@(FireWallHelperOut->'$(OutDir)bin\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(NativeFiles)" DestinationFolder="$(OutDir)bin\" SkipUnchangedFiles="true" />
  </Target>

  <!-- 非打包模式下 WinUI SDK 不会把 XBF/PRI 带入 publish，缺失会导致 XAML 启动崩溃 -->
  <Target Name="BundleHelpersAndNativeOnPublish" AfterTargets="Publish">
    <ItemGroup>
      <FireWallHelperOut Include="..\FireWallHelper\bin\$(Configuration)\net10.0-windows\win-x64\**\*.*" />
      <NativeFiles Include="..\..\native\*.*" />
      <XbfFiles Include="$(OutDir)**\*.xbf" />
      <PriFiles Include="$(OutDir)*.pri" />
    </ItemGroup>
    <Copy SourceFiles="@(FireWallHelperOut)" DestinationFiles="@(FireWallHelperOut->'$(PublishDir)bin\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(NativeFiles)" DestinationFolder="$(PublishDir)bin\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(XbfFiles)" DestinationFiles="@(XbfFiles->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PriFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- XAML 编译器不加载本程序集（net472 XamlCompiler.exe 无法加载 net10.0 输出程序集），
       且各 XAML 已不再声明同程序集类型（转换器已改为 App.xaml.cs 代码注册，已移除 x:DataType/local 命名空间），
       因此无需在 MarkupCompilePass2 前注入 LocalAssembly；保持为空仅产生无害的 WMC1509 警告。 -->
</Project>
