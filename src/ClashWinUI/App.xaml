<Application
    x:Class="ClashDotNetFramework.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!--
                资源分层（合并顺序即依赖顺序，不要调换）：
                  1. XamlControlsResources —— WinUI 内置控件模板与基础资源
                  2. Themes/Tokens.xaml   —— 度量令牌（间距 / 圆角 / 字号），与主题无关
                  3. Themes/Palette.*.xaml—— 颜色令牌，三套主题各一份；
                                              这里先合并默认的"现代"，运行时由
                                              ThemeManager 按用户设置整份替换
                  4. Themes/Controls.xaml —— 样式层，只引用上面两层定义的令牌
            -->
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Themes/Tokens.xaml" />
                <ResourceDictionary Source="Themes/Palette.Modern.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
