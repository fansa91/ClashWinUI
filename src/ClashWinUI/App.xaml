<Application
    x:Class="ClashDotNetFramework.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:ClashDotNetFramework.Models.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
            <conv:LatencyToTextConverter x:Key="LatencyToText" />
            <conv:LatencyToColorConverter x:Key="LatencyToColor" />
            <conv:LevelToColorConverter x:Key="LevelToColor" />
            <conv:SelectedToBackgroundConverter x:Key="SelectedToBackground" />
            <conv:ProfileTypeToStringConverter x:Key="ProfileTypeToString" />
        </ResourceDictionary>
    </Application.Resources>
</Application>